generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id               Int      @id @default(autoincrement())
  razonSocial      String
  rut              String   @unique
  contactoNombre   String
  contactoEmail    String?
  contactoTelefono String?
  predios          Predio[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Predio {
  id           Int          @id @default(autoincrement())
  nombre       String
  csg          String       @unique
  superficie   Float
  cultivo      String
  ubicacion    String
  activa       Boolean      @default(true)
  variedades   String?
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  empresaId    Int
  encargado    Usuario?     @relation("Encargado", fields: [encargadoId], references: [id])
  encargadoId  Int?
  labores      Labor[]
  aplicaciones Aplicacion[]
  visitas      Visita[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Usuario {
  id           Int          @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String       @unique
  rol          String
  telefono     String?
  activo       Boolean      @default(true)
  predios      Predio[]     @relation("Encargado")
  labores      Labor[]      @relation("Responsable")
  aplicaciones Aplicacion[] @relation("Tecnico")
  visitas      Visita[]     @relation("TecnicoVisita")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Visita {
  id            Int          @id @default(autoincrement())
  fecha         DateTime
  predio        Predio       @relation(fields: [predioId], references: [id])
  predioId      Int
  tecnico       Usuario      @relation("TecnicoVisita", fields: [tecnicoId], references: [id])
  tecnicoId     Int
  observaciones String?
  estado        String       @default("EN_PROGRESO")
  labores       Labor[]
  aplicaciones  Aplicacion[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Labor {
  id            Int       @id @default(autoincrement())
  tipo          String
  descripcion   String
  fecha         DateTime
  fechaFin      DateTime?
  estado        String    @default("PENDIENTE")
  observaciones String?
  dibujo        String?
  predio        Predio    @relation(fields: [predioId], references: [id])
  predioId      Int
  responsable   Usuario   @relation("Responsable", fields: [responsableId], references: [id])
  responsableId Int
  visita        Visita?   @relation(fields: [visitaId], references: [id])
  visitaId      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ProgramaFitosanitario {
  id                    Int      @id @default(autoincrement())
  temporada             String
  cultivo               String
  estadoFenologico      String?
  caracterAplicacion    String
  tratamientoObjetivo   String?
  fechaEstimada         String
  producto              String
  ingredienteActivo     String?
  concentracion         String?
  mojamiento            String?
  dosisHa               String?
  observaciones         String?
  productosAlternativos String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CatalogoLabor {
  id             Int      @id @default(autoincrement())
  grupo          String
  especie        String
  categoria      String
  labor          String
  descripcion    String
  prioridad      String
  mesesEjecucion String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Aplicacion {
  id            Int       @id @default(autoincrement())
  producto      String
  tipoProducto  String
  dosis         Float
  unidad        String
  fecha         DateTime
  estado        String    @default("PENDIENTE")
  observaciones String?
  predio        Predio    @relation(fields: [predioId], references: [id])
  predioId      Int
  tecnico       Usuario   @relation("Tecnico", fields: [tecnicoId], references: [id])
  tecnicoId     Int
  visita        Visita?   @relation(fields: [visitaId], references: [id])
  visitaId      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
