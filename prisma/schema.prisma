generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recorrido {
  id             Int      @id @default(autoincrement())
  fecha          DateTime
  kmInicio       Float
  kmFin          Float
  litrosCargados Float?
  notas          String?
  tecnico        Usuario  @relation("TecnicoRecorrido", fields: [tecnicoId], references: [id])
  tecnicoId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AgendaVisita {
  id        Int       @id @default(autoincrement())
  fecha     DateTime
  notas     String?
  predio    Predio    @relation(fields: [predioId], references: [id])
  predioId  Int
  tecnico   Usuario   @relation("TecnicoAgenda", fields: [tecnicoId], references: [id])
  tecnicoId Int
  checkins  CheckIn[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CheckIn {
  id        Int          @id @default(autoincrement())
  fecha     DateTime     @default(now())
  latitud   Float
  longitud  Float
  notas     String?
  tecnico   Usuario      @relation("TecnicoCheckIn", fields: [tecnicoId], references: [id])
  tecnicoId Int
  predio    Predio?      @relation(fields: [predioId], references: [id])
  predioId  Int?
  agenda    AgendaVisita? @relation(fields: [agendaId], references: [id])
  agendaId  Int?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Empresa {
  id               Int      @id @default(autoincrement())
  razonSocial      String
  rut              String   @unique
  contactoNombre   String
  contactoEmail    String?
  contactoTelefono String?
  predios          Predio[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Predio {
  id           Int          @id @default(autoincrement())
  nombre       String
  csg          String       @unique
  superficie   Float
  cultivo      String
  ubicacion    String
  activa       Boolean      @default(true)
  variedades   String?
  latitud      Float?
  longitud     Float?
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  empresaId    Int
  encargado    Usuario?     @relation("Encargado", fields: [encargadoId], references: [id])
  encargadoId  Int?
  labores      Labor[]
  aplicaciones Aplicacion[]
  visitas      Visita[]
  agendas      AgendaVisita[]
  checkins     CheckIn[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Usuario {
  id           Int          @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String       @unique
  rol          String
  telefono     String?
  activo       Boolean      @default(true)
  predios      Predio[]     @relation("Encargado")
  labores      Labor[]      @relation("Responsable")
  aplicaciones Aplicacion[] @relation("Tecnico")
  visitas      Visita[]       @relation("TecnicoVisita")
  agendas      AgendaVisita[] @relation("TecnicoAgenda")
  recorridos   Recorrido[]    @relation("TecnicoRecorrido")
  checkins     CheckIn[]      @relation("TecnicoCheckIn")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Visita {
  id            Int          @id @default(autoincrement())
  fecha         DateTime
  predio        Predio       @relation(fields: [predioId], references: [id])
  predioId      Int
  tecnico       Usuario      @relation("TecnicoVisita", fields: [tecnicoId], references: [id])
  tecnicoId     Int
  observaciones String?
  estado        String       @default("EN_PROGRESO")
  labores       Labor[]
  aplicaciones  Aplicacion[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Labor {
  id            Int       @id @default(autoincrement())
  tipo          String
  descripcion   String
  fecha         DateTime
  fechaFin      DateTime?
  estado        String    @default("PENDIENTE")
  observaciones String?
  dibujo        String?
  predio        Predio    @relation(fields: [predioId], references: [id])
  predioId      Int
  responsable   Usuario   @relation("Responsable", fields: [responsableId], references: [id])
  responsableId Int
  visita        Visita?   @relation(fields: [visitaId], references: [id])
  visitaId      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ProgramaFitosanitario {
  id                    Int      @id @default(autoincrement())
  temporada             String
  cultivo               String
  estadoFenologico      String?
  caracterAplicacion    String
  tratamientoObjetivo   String?
  fechaEstimada         String
  producto              String
  ingredienteActivo     String?
  concentracion         String?
  mojamiento            String?
  dosisHa               String?
  observaciones         String?
  productosAlternativos String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CatalogoLabor {
  id             Int      @id @default(autoincrement())
  grupo          String
  especie        String
  categoria      String
  labor          String
  descripcion    String
  prioridad      String
  mesesEjecucion String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Aplicacion {
  id            Int       @id @default(autoincrement())
  producto      String
  tipoProducto  String
  dosis         Float
  unidad        String
  fecha         DateTime
  estado        String    @default("PENDIENTE")
  observaciones String?
  predio        Predio    @relation(fields: [predioId], references: [id])
  predioId      Int
  tecnico       Usuario   @relation("Tecnico", fields: [tecnicoId], references: [id])
  tecnicoId     Int
  visita        Visita?   @relation(fields: [visitaId], references: [id])
  visitaId      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ── Módulo Cosecha & Exportación ─────────────────────────────────────────────

model Temporada {
  id                  Int                   @id @default(autoincrement())
  nombre              String                @unique
  descripcion         String?
  activa              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  programacionSemanal ProgramacionSemanal[]
  compromisosCliente  CompromisoCliente[]
  cosechaReal         CosechaReal[]
  preciosCalibres     PrecioCalibres[]
}

model VariedadCosecha {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique
  nombre        String
  semanaInicio  String
  semanaFin     String
  pct5J         Float    @default(0)
  pct4J         Float    @default(0)
  pct3J         Float    @default(0)
  pct2J         Float    @default(0)
  pctJ          Float    @default(0)
  pctXL         Float    @default(0)
  pctExportacion Float   @default(0.85)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProgramacionSemanal {
  id           Int       @id @default(autoincrement())
  temporada    Temporada @relation(fields: [temporadaId], references: [id])
  temporadaId  Int
  variedad     String
  productor    String
  sem44        Int       @default(0)
  sem45        Int       @default(0)
  sem46        Int       @default(0)
  sem47        Int       @default(0)
  sem48        Int       @default(0)
  sem49        Int       @default(0)
  sem50        Int       @default(0)
  sem51        Int       @default(0)
  sem52        Int       @default(0)
  sem1         Int       @default(0)
  sem2         Int       @default(0)
  totalKg      Int       @default(0)
  kg2JMasGrandes Int     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CompromisoCliente {
  id                  Int       @id @default(autoincrement())
  temporada           Temporada @relation(fields: [temporadaId], references: [id])
  temporadaId         Int
  cliente             String
  pais                String
  variedad            String
  calibreSolicitado   String
  sem47               Int       @default(0)
  sem48               Int       @default(0)
  sem49               Int       @default(0)
  sem50               Int       @default(0)
  sem51               Int       @default(0)
  totalKgComprometido Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model CosechaReal {
  id          Int       @id @default(autoincrement())
  temporada   Temporada @relation(fields: [temporadaId], references: [id])
  temporadaId Int
  variedad    String
  semana      String
  kgReal      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PrecioCalibres {
  id          Int       @id @default(autoincrement())
  temporada   Temporada @relation(fields: [temporadaId], references: [id])
  temporadaId Int
  calibre     String
  precioUSD   Float
  precioBajo  Float
  precioAlto  Float
  descripcion String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
