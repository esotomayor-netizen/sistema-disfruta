generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id               Int      @id @default(autoincrement())
  razonSocial      String
  rut              String   @unique
  contactoNombre   String
  contactoEmail    String?
  contactoTelefono String?
  predios          Predio[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Predio {
  id           Int          @id @default(autoincrement())
  nombre       String
  csg          String       @unique
  superficie   Float
  cultivo      String
  ubicacion    String
  activa       Boolean      @default(true)
  variedades   String?
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  empresaId    Int
  encargado    Usuario?     @relation("Encargado", fields: [encargadoId], references: [id])
  encargadoId  Int?
  labores      Labor[]
  aplicaciones Aplicacion[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Usuario {
  id           Int          @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String       @unique
  rol          String
  telefono     String?
  activo       Boolean      @default(true)
  predios      Predio[]     @relation("Encargado")
  labores      Labor[]      @relation("Responsable")
  aplicaciones Aplicacion[] @relation("Tecnico")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Labor {
  id            Int       @id @default(autoincrement())
  tipo          String
  descripcion   String
  fecha         DateTime
  fechaFin      DateTime?
  estado        String    @default("PENDIENTE")
  observaciones String?
  predio        Predio    @relation(fields: [predioId], references: [id])
  predioId      Int
  responsable   Usuario   @relation("Responsable", fields: [responsableId], references: [id])
  responsableId Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ProgramaFitosanitario {
  id                    Int      @id @default(autoincrement())
  temporada             String
  cultivo               String
  estadoFenologico      String?
  caracterAplicacion    String
  tratamientoObjetivo   String?
  fechaEstimada         String
  producto              String
  ingredienteActivo     String?
  concentracion         String?
  mojamiento            String?
  dosisHa               String?
  observaciones         String?
  productosAlternativos String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CatalogoLabor {
  id             Int      @id @default(autoincrement())
  grupo          String
  especie        String
  categoria      String
  labor          String
  descripcion    String
  prioridad      String
  mesesEjecucion String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Aplicacion {
  id            Int       @id @default(autoincrement())
  producto      String
  tipoProducto  String
  dosis         Float
  unidad        String
  fecha         DateTime
  estado        String    @default("PENDIENTE")
  observaciones String?
  predio        Predio    @relation(fields: [predioId], references: [id])
  predioId      Int
  tecnico       Usuario   @relation("Tecnico", fields: [tecnicoId], references: [id])
  tecnicoId     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RecepcionCalidad {
  id                             Int      @id @default(autoincrement())
  codEmp                         String
  lote                           Int
  guia                           String
  binsTotems                     Int
  horaLlegada                    String?
  tipoTransporte                 String?
  patente                        String?
  fechaMuestra                   DateTime
  exportadora                    String
  productor                      String
  predioDescripcion              String
  csg                            String
  variedad                       String
  tempPulpa                      Float?
  grsMuestra                     Float?
  decisionFinal                  String?
  clasificacionFinal             String?
  estadoCarpa                    Int?
  estadoEsponja                  Int?
  estadoTotem                    Int?
  estadoRacimo                   Int?
  estadoRestos                   Int?
  estadoLimpCamion               Int?
  estadoLimpBins                 Int?
  estadoHidrocooler              Int?
  // Defectos de condición
  condMachuconM1                 Float?
  condSobremadurezM1             Float?
  condHerIdaAbiertaM1            Float?
  condDanioPajaroM1              Float?
  condPittingM1                  Float?
  condPartiduraSuperficialM1     Float?
  condPudricionM1                Float?
  condPartiduraEstrellaM1        Float?
  condPartiduraMediaLunaM1       Float?
  condDeshidratacionFrutoPediM1  Float?
  condDesgarroPedicelarM1        Float?
  condOtro1M1                    Float?
  condOtro2M1                    Float?
  // Defectos de calidad
  calRoceM1                      Float?
  calRussetM1                    Float?
  calManchaM1                    Float?
  calDeformeM1                   Float?
  calFrutoDobleM1                Float?
  calHerIdaCicatrizadaM1         Float?
  calPreCalibreM1                Float?
  calFaltaColorM1                Float?
  calDanioInsectoM1              Float?
  calVirosisM1                   Float?
  calOtro1M1                     Float?
  // Resumen
  resTotalDefectosM1             Float?
  resFrutaSanaM1                 Float?
  // Calibres
  calibre5J                      Float?
  calibre4J                      Float?
  calibre3J                      Float?
  calibre2J                      Float?
  calibreJ                       Float?
  calibreXL                      Float?
  calibreL                       Float?
  calibrePC                      Float?
  // Observaciones
  observaciones                  String?
  createdAt                      DateTime @default(now())
}
